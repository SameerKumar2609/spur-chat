# ─── LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────
# Option A: connection string (takes precedence if set)
DATABASE_URL=postgresql://postgres:password@localhost:5432/spur_chat

# Option B: individual vars (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spur_chat
DB_USER=postgres
DB_PASSWORD=password

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173
